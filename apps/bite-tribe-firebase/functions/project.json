{
  "name": "functions",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bite-tribe-firebase/functions/src",
  "projectType": "application",
  "tags": ["scope:firebase"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/bite-tribe-firebase/functions/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "apps/bite-tribe-firebase/functions",
        "command": "jest --config jest.config.cjs --runInBand"
      }
    }
  }
}
