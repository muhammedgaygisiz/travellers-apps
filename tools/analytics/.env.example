# Copy to tools/analytics/.env (git-ignored) or export these in your shell.
# See tools/analytics/README.md for how to obtain each value.

# Numeric GA4 property id (Firebase → Analytics links a GA4 property).
GA4_PROPERTY_ID=123456789

# Absolute path to a service-account JSON key with Viewer access on the GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional. Cloud project holding the GA4 → BigQuery export dataset.
# Defaults to the service-account key's project, which is the Firebase project.
# BIGQUERY_PROJECT_ID=bite-tribe

# Optional. Location for a *newly created* export dataset (default EU).
# GA4 fixes this at link creation and cannot move the dataset afterwards.
# BIGQUERY_DATASET_LOCATION=EU
