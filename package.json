{
  "name": "travellers-apps",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "loki": "nx loki",
    "start": "nx serve",
    "build": "nx build",
    "test": "nx affected --base=develop -t test --parallel --coverage --coverageReporters=text",
    "pwa-asset-generator": "pwa-asset-generator",
    "start:prices": "nx serve prices",
    "start:storybook:prices": "nx run prices:storybook",
    "build:storybook:prices": "nx run prices:build-storybook",
    "prepare": "husky",
    "compile:loki:executor": "tsc --project tools/executors/loki/tsconfig.executor.json",
    "prices:loki:approve": "nx loki prices --configuration=approve",
    "kosaml:loki:approve": "nx loki kosaml --configuration=approve",
    "cap:sync": "nx run prices-ios:sync",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "pwa-asset-generator:generate:prices": "pwa-asset-generator apps/prices/src/logo.svg -i apps/prices/src/index.html --favicon -m apps/prices/src/manifest.webmanifest apps/prices/src/assets/icons",
    "pwa-asset-generator:generate:finances": "pwa-asset-generator apps/finances/src/logo.svg -i apps/finances/src/index.html --favicon -m apps/finances/src/manifest.webmanifest apps/finances/src/assets/icons",
    "ios-asset-generator:generate-ios:finances": "capacitor-assets generate --ios --iosProject apps/finances-ios/ios/App --assetPath apps/finances-ios/assets --iconBackgroundColor '#eeeeee' --iconBackgroundColorDark '#222222' --splashBackgroundColor '#eeeeee' --splashBackgroundColorDark '#111111' --logoSplashTargetWidth '1366'",
    "pwa-asset-generator:generate:bite-tribe": "pwa-asset-generator apps/bite-tribe/src/logo.png -i apps/bite-tribe/src/index.html --favicon -m apps/bite-tribe/src/manifest.webmanifest apps/bite-tribe/src/assets/icons",
    "ios-asset-generator:generate-ios:bite-tribe": "capacitor-assets generate --ios --iosProject apps/bite-tribe-ios/ios/App --assetPath apps/bite-tribe-ios/assets --iconBackgroundColor '#FFFBEA' --iconBackgroundColorDark '#FFFBEA' --splashBackgroundColor '#FFFBEA' --splashBackgroundColorDark '#FFFBEA' --logoSplashTargetWidth '1390'",
    "commitizen": "commitizen",
    "husky": "husky",
    "commit": "cz"
  },
  "private": true,
