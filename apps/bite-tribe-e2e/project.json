{
  "name": "bite-tribe-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bite-tribe-e2e/src",
  "tags": ["scope:bite-tribe"],
  "implicitDependencies": ["bite-tribe", "bite-tribe-firebase"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/bite-tribe-e2e"],
      "options": {
        "config": "apps/bite-tribe-e2e/playwright.config.ts"
      },
      "dependsOn": ["bite-tribe-firebase:firebase-build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
