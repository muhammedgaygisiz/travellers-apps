{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "types": ["node"],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types",
      "../../../node_modules/@types"
    ],
    "noUncheckedSideEffectImports": false,
    "rootDir": "src"
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.emulator-spec.ts"]
}
