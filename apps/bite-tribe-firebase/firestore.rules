rules_version = '2';

/**
 * Ownership-scoped access rules for BiteTribe (GitHub issue #1078).
 *
 * Until this file was written, every collection was covered by one match on
 * `/{document=**}` allowing read and write to any signed-in account. That made
 * the ownership model decorative: a business account could write
 * `ownerUserId` onto any restaurant and hold it, without going near the
 * operator callables that exist to make the decision accountable.
 *
 * Three rules of thumb hold everywhere below, and reading them once is cheaper
 * than reading them per collection:
 *
 * 1. **Reads stay where they were.** Every collection a signed-in account
 *    could read before, it can still read. Narrowing reads is issue #1079's
 *    visible scope, not this one's, and mixing the two would make a regression
 *    here indistinguishable from a regression there. The two exceptions are
 *    named at their own match blocks: `accountDeletions` and the `pushTokens`
 *    index are cross-account identifiers no client ever read.
 *
 * 2. **A write is allowed by ownership, not by a role.** The account named on
 *    the document writes it. The one role that appears here is `admin`, and it
 *    appears as an explicit clause rather than as an implied `business` — see
 *    the operator note on `isOperator()`.
 *
 * 3. **Backend-owned fields are named, not assumed.** A field the Admin SDK
 *    owns can sit on a document the client may otherwise write, so the rule has
 *    to name the field. Callables bypass rules entirely, so denying every
 *    client write to such a field costs the backend nothing.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    /**
     * The roles on the verified ID token, as a list.
     *
     * An account that was never granted a role carries no `roles` key at all,
     * and a malformed claim is possible because claims are written by a
     * callable rather than by a schema, so the absent and the wrong-shape cases
     * both have to resolve to "no roles" rather than to an error. An error in a
     * rule denies the request, which would be the right answer here by accident
     * and the wrong one anywhere this helper is later reused.
     */
    function roleList() {
      return signedIn() && request.auth.token.get('roles', []) is list
        ? request.auth.token.get('roles', [])
        : [];
    }

    /**
     * A BiteTribe operator.
     *
     * **`admin` does not imply `business`** (GitHub issue #1164). The roles are
     * deliberately not a hierarchy: an operator account is not a restaurant,
     * and granting it restaurant maintenance by implication would make the
     * business app's only-what-you-own gate meaningless for the accounts most
     * able to break it. So an operator is admitted here by name, at the
     * specific collections the admin app writes — creating a restaurant,
     * running a Bite migration — and is admitted to the business app nowhere.
     * Restaurant maintenance always goes through an assigned owner, which
     * `assignRestaurantOwner` provides (issue #1077).
     *
     * The consequence to accept with it: an operator write from the admin app
     * lands as a plain client write and leaves nothing in the operator log,
     * unlike the ownership callables. Attributability for those surfaces is the
     * part of #1164 this branch does not close.
     */
    function isOperator() {
      return 'admin' in roleList();
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    /** The field naming the account behind a document, absent-safe. */
    function ownerOf(data, field) {
      return data.get(field, '');
    }

    function owns(data, field) {
      return signedIn() && ownerOf(data, field) == uid();
    }

    /** True when the write leaves every one of `fields` at its current value. */
    function unchangedAll(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function absentAll(fields) {
      return !request.resource.data.keys().hasAny(fields);
    }

    // ------------------------------------------------------------ restaurants

    /**
     * Written only by `assignRestaurantOwner` and `revokeRestaurantOwner`
     * through the Admin SDK, which is not subject to these rules.
     *
     * They are listed rather than protected by the document's owner check,
     * because they live on a document the owner may otherwise write: without
     * naming them, the account holding a restaurant could hand it to another
     * account, and any business account could take an unheld one.
     */
    function ownershipFields() {
      return ['ownerUserId', 'claimStatus', 'claimedAt', 'claimedAtTimestamp'];
    }

    function restaurantData(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
    }

    function restaurantExists(restaurantId) {
      return restaurantId is string
        && restaurantId.size() > 0
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId));
    }

    function ownsRestaurant(restaurantId) {
      return restaurantExists(restaurantId)
        && owns(restaurantData(restaurantId), 'ownerUserId');
    }

    match /restaurants/{restaurantId} {
      allow read: if signedIn();

      /**
       * Creating a restaurant is an operator action.
       *
       * The only client that creates one is the admin app's new-restaurant
       * page; `verifyRestaurantCandidate` creates the rest through the Admin
       * SDK. A business account acquires a restaurant by being assigned one,
       * never by writing one for itself — which is also why a create may not
       * carry the ownership fields.
       */
      allow create: if isOperator() && absentAll(ownershipFields());

      allow update: if unchangedAll(ownershipFields())
        && (isOperator() || owns(resource.data, 'ownerUserId'));

      allow delete: if isOperator();
    }

    // ------------------------------------------------------------------ menus

    /**
     * A menu document says nothing about who may write it: it holds categories
     * and timestamps, and the only link to a restaurant is `Restaurant.menuId`
     * pointing the other way. Rules cannot query, so the caller names the
     * restaurant it is acting for and the rule verifies the claim against that
     * restaurant document — which already carries both `ownerUserId` and
     * `menuId`. Checking `menuId` is what stops an owner naming their own
     * restaurant to reach somebody else's menu.
     *
     * Reading the restaurant rather than a field on the menu is also what makes
     * this work with no backfill: menus written before this rule carry no
     * `restaurantId`, and the check never reads one off the menu.
     */
    function ownsMenu(menuId) {
      return ownsRestaurant(request.resource.data.get('restaurantId', ''))
        && restaurantData(request.resource.data.get('restaurantId', '')).get('menuId', '') == menuId;
    }

    match /menus/{menuId} {
      allow read: if signedIn();

      /**
       * At create time the restaurant does not point at the menu yet — the
       * client writes `menuId` back onto it immediately afterwards — so the
       * create can only check ownership of the named restaurant, and the
       * `menuId` half of the check starts holding from the first update.
       */
      allow create: if isOperator()
        || ownsRestaurant(request.resource.data.get('restaurantId', ''));

      allow update: if isOperator() || ownsMenu(menuId);

      allow delete: if isOperator();
    }

    // ------------------------------------------------------- restaurant staff

    /**
     * Who works at a restaurant: one document per staff account, named by that
     * account's own uid (GitHub issue #1537).
     *
     * **Written by nobody.** `addRestaurantStaff` and `removeRestaurantStaff`
     * write it through the Admin SDK, and they have to: the association only
     * makes sense together with the `staff` custom claim, and a claim is not
     * something a client can write at all. A client create here would be an
     * account putting itself on a restaurant.
     *
     * Reads are narrow, unlike everywhere else in this file. The three rules of
     * thumb at the top say reads stay where they were - and this collection has
     * no "where they were": it is new, so nothing regresses by starting closed.
     * What it holds is who works where, which is a fact about a person rather
     * than about a restaurant, and that is exactly why it is not a
     * `staffUserIds` array on the world-readable restaurant document.
     *
     * Three readers, and each is someone the fact is already about: the account
     * itself, the operator, and the account holding the restaurant. The last
     * one costs a `get()` on the restaurant, which is why the business app
     * reads its staff list through `listRestaurantStaff` instead of querying
     * this collection - a query would pay that `get()` per result.
     */
    match /restaurantStaff/{staffUserId} {
      allow read: if isSelf(staffUserId)
        || isOperator()
        || ownsRestaurant(resource.data.get('restaurantId', ''));

      allow write: if false;
    }

    // ------------------------------------------------------------ floor plans

    /**
     * A restaurant's floor plan: rooms with their geometry, and one document
     * per table (GitHub issue #1081).
     *
     * ```text
     * /restaurants/{restaurantId}/rooms/{roomId}
     * /restaurants/{restaurantId}/tables/{tableId}
     * ```
     *
     * Nothing above matched these paths before, so the catch-all at the bottom
     * denied them: the plan is new, and like `restaurantStaff` it has no "where
     * reads were" to preserve. Rule of thumb 1 therefore does not apply, and
     * reads start scoped to the account holding the restaurant. That is what
     * makes the plan a plan and not a public map of a business's interior.
     *
     * **Staff read the published plan** (GitHub issue #1088). The clause was
     * parked until there was a published state to give them, because until the
     * draft moved out of the room document a staff read would have handed them
     * the arrangement an owner was halfway through. It now cannot: an
     * unpublished change lives at `rooms/{roomId}/drafts/current`, which has
     * its own match block below and no staff clause in it, and an unpublished
     * table has no document under `tables` at all.
     *
     * Scoped to the one restaurant the account works at, never to `staff` as a
     * role. A blanket any-staff-reads-any-plan clause would make the role a
     * key to every restaurant's interior in BiteTribe, which is the shape of
     * hole issue #1537 closed for the restaurant document.
     *
     * **An operator reads and does not write.** Support has to be able to see
     * what an owner is describing on the phone, and that is a read. Editing the
     * plan is restaurant maintenance, and per the note on `isOperator()` the
     * `admin` role never acquires restaurant maintenance by implication - it
     * goes through the assigned owner.
     */
    function readsFloorPlan(restaurantId) {
      return isOperator() || ownsRestaurant(restaurantId) || worksAt(restaurantId);
    }

    /**
     * Whether the caller is staff of this one restaurant (GitHub issue #1537).
     *
     * Both halves are required, because either alone is a hole. The claim
     * without the association is "some restaurant employs this account", which
     * says nothing about *this* restaurant; the association without the claim
     * is a document that outlived the grant it was written with, and
     * `removeRestaurantStaff` is not the only way a role can end.
     *
     * The association is read by the caller's own uid, so this is one `get()`
     * on a document named in advance rather than a query - which is what lets
     * it sit in a rule at all.
     */
    function worksAt(restaurantId) {
      return signedIn()
        && 'staff' in roleList()
        && exists(/databases/$(database)/documents/restaurantStaff/$(uid()))
        && get(/databases/$(database)/documents/restaurantStaff/$(uid())).data.get('restaurantId', '') == restaurantId;
    }

    /**
     * The optimistic-concurrency version of a room, absent-safe.
     *
     * Absent reads as `0` rather than erroring, so a document that predates the
     * field - or a write that forgets it - fails the comparison below instead
     * of failing the whole rule evaluation, which would deny reads too.
     */
    function roomVersion(data) {
      return data.get('version', 0);
    }

    match /restaurants/{restaurantId}/rooms/{roomId} {
      allow read: if readsFloorPlan(restaurantId);

      /**
       * A room is born at version 1, so "version 1" in a conflict message means
       * the first saved state and not the absence of one.
       */
      allow create: if ownsRestaurant(restaurantId)
        && roomVersion(request.resource.data) == 1;

      /**
       * Optimistic concurrency, enforced here rather than in the client.
       *
       * The editor reads a room at version `n` and saves `n + 1`. Two devices
       * that both read `n` both try to write `n + 1`; the first one lands and
       * the room becomes `n + 1`, so the second is now asking to write a
       * version that is no longer the successor of what is stored, and is
       * refused. The loser is told to reload instead of silently overwriting a
       * rearrangement it never saw.
       *
       * A rule rather than a transaction because a transaction protects only
       * the client that opens one. This refuses the write whatever wrote it.
       */
      allow update: if ownsRestaurant(restaurantId)
        && roomVersion(request.resource.data) == roomVersion(resource.data) + 1;

      /**
       * A room with tables still in it must not be deleted ([[Floor Plan]]),
       * and that cannot be checked here: rules read named documents and cannot
       * query, so no rule can ask whether a collection is empty. The guard
       * lives in `FloorPlanDataAccessService.deleteRoom`, which is the right
       * place for it - an owner orphaning their own tables is a data-integrity
       * mistake, not an account reaching data it does not hold, and that part
       * is refused here.
       */
      allow delete: if ownsRestaurant(restaurantId);
    }

    /**
     * The revision of a room's draft, absent-safe.
     *
     * Absent reads as `0`, so the first draft of a room is written at revision
     * 1 through the same successor check that governs every later write, and a
     * draft that carries no revision at all fails that check rather than
     * failing the whole rule evaluation.
     */
    function draftRevision(data) {
      return data.get('revision', 0);
    }

    /**
     * A room's unpublished arrangement (GitHub issue #1088).
     *
     * ```text
     * /restaurants/{restaurantId}/rooms/{roomId}/drafts/current
     * ```
     *
     * **The owner and nobody else, not even the operator.** A subcollection is
     * not covered by its parent's match block, so this starts from nothing and
     * every reader is admitted by name. Staff are deliberately absent: this
     * document is the whole reason `readsFloorPlan` can now admit them to the
     * room, and letting them read it would put the half-finished plan back in
     * front of exactly the people the split protects. The operator is absent
     * for a narrower reason - support answers questions about the plan a
     * restaurant is running, and an owner's unpublished rearrangement is not
     * that plan.
     *
     * **Its own counter, not the room's version.** An autosave writes this
     * document every few seconds, and a shared counter would make each one
     * look like a publish. The successor rule is the same otherwise, so two
     * devices arranging one room cannot silently overwrite each other's work.
     *
     * **A delete carries no revision check.** Discarding is what the owner does
     * to throw the arrangement away, and publishing is what the editor does
     * once the room document has been written; neither is a state a stale
     * revision could make wrong, because both end with "there is no draft".
     */
    match /restaurants/{restaurantId}/rooms/{roomId}/drafts/{draftId} {
      allow read: if ownsRestaurant(restaurantId);

      allow create: if ownsRestaurant(restaurantId)
        && draftRevision(request.resource.data) == 1;

      allow update: if ownsRestaurant(restaurantId)
        && draftRevision(request.resource.data) == draftRevision(resource.data) + 1;

      allow delete: if ownsRestaurant(restaurantId);
    }

    /**
     * The field naming a table's active QR token.
     *
     * Written only by `issueTableQrTokens`, `rotateTableQrToken` and
     * `syncTableQrTokenOnTableWrite` through the Admin SDK (issue #1086). It is
     * named here for the same reason as `ownershipFields()`: it sits on a
     * document the owner may otherwise write, and without naming it an owner
     * could point their table at another restaurant's token, or at a token that
     * was never issued - which is a table whose printed code resolves to
     * somewhere else, or to nothing.
     *
     * The comparison is by value, so an ordinary table save is unaffected. The
     * editor reads a table and writes it back whole, token field included, and
     * `diff()` reports only a *changed* value as affected.
     */
    function tokenFields() {
      return ['qrTokenId'];
    }

    /**
     * One document per table, not a subcollection of its room, because a table
     * keeps its identity when it moves between rooms: `roomId` is a field, and
     * moving the table is a field change rather than a delete and recreate of
     * the document its QR token, visits and orders point at.
     *
     * Carrying no version is deliberate. A room holds the geometry both devices
     * edit as one blob, which is where a silent overwrite hurts; a table is one
     * small document changed by one deliberate action.
     *
     * A delete is still the owner's, and it is what revokes the table's token:
     * `syncTableQrTokenOnTableWrite` ends the token rather than the rule
     * refusing the delete, because a table that is gone must not keep a code
     * that still resolves.
     */
    match /restaurants/{restaurantId}/tables/{tableId} {
      allow read: if readsFloorPlan(restaurantId);

      allow create: if ownsRestaurant(restaurantId)
        && absentAll(tokenFields());

      allow update: if ownsRestaurant(restaurantId)
        && unchangedAll(tokenFields());

      allow delete: if ownsRestaurant(restaurantId);
    }

    // ----------------------------------------------------- live table state

    /**
     * What each table is doing right now, and how it got there
     * (GitHub issue #1092).
     *
     * ```text
     * /restaurants/{restaurantId}/tableStates/{tableId}
     * /restaurants/{restaurantId}/tableStateTransitions/{transitionId}
     * ```
     *
     * **Written by nobody**, exactly like `restaurantStaff` above and for a
     * sharper reason. Two hosts tapping "seat" on table 12 in the same second
     * is the case the whole feature is built around: with client writes the
     * later one lands and the restaurant has one table and two parties, with no
     * record that it happened. `transitionTableState` applies the change in a
     * transaction against the state the caller says it saw, so exactly one of
     * the two commits and the other is told what the table holds now. A client
     * write here would be a way round that, so there is not one - the callable
     * is not merely the path the app takes, it is the only path there is.
     *
     * The audit entries are append-only for the same reason they exist: a
     * disputed table is answered by a history nobody could have edited
     * afterwards. The Admin SDK bypasses rules, so "append-only" is this rule
     * refusing every client write plus `transitionTableState` using `create`
     * rather than `set` on the entry.
     *
     * **Reads go to whoever reads the floor plan**, which is what makes the
     * live view of issue #1093 a plain realtime subscription rather than a
     * second callable: staff of this restaurant, the account holding it, and
     * the operator for support. Deliberately the same `readsFloorPlan` the
     * tables use - a table's live state is worth no more protection than the
     * table, and worth no less, and two lists of readers for one room would
     * drift.
     *
     * Unlike the room draft, the transitions are **not** withheld from staff.
     * A draft is an owner's unfinished thinking; this is what the people on
     * shift did during service, and the person asking "who freed table 6" is
     * usually one of them.
     */
    match /restaurants/{restaurantId}/tableStates/{tableId} {
      allow read: if readsFloorPlan(restaurantId);

      allow write: if false;
    }

    match /restaurants/{restaurantId}/tableStateTransitions/{transitionId} {
      allow read: if readsFloorPlan(restaurantId);

      allow write: if false;
    }

    // ----------------------------------------------------------- table visits

    /**
     * A party at a table over time (GitHub issue #1095).
     *
     * ```text
     * /restaurants/{restaurantId}/visits/{visitId}
     * ```
     *
     * **Written by nobody**, for the same reason as the state document it is
     * paired with. A visit and the `tableStates` pointer at it are written in
     * one transaction by `transitionTableState` and `moveTableVisit`, and a
     * client able to write here could open a second visit at a table that
     * already has one - which is the single rule the whole feature rests on,
     * because the orders of issue #1072 and the bill of issue #1073 hang from
     * the visit. A party billed for the next party's dinner is what that hole
     * looks like from the dining room.
     *
     * Under the restaurant rather than under the table, so a table deleted
     * from the floor plan does not take the record of what happened at it.
     * That is also why this is a `match` of its own rather than a
     * subcollection of the `tables` rule above.
     *
     * **Reads go to whoever reads the floor plan**, the same list as the
     * tables and their live state, so the staff view follows the pointer on a
     * state document it is already subscribed to without a callable in the
     * way. The guest who scanned the QR code is not on that list and does not
     * need to be yet; a guest reading their own visit is issue #1072, which
     * has a session to scope it with and no shape to write against until the
     * orders exist.
     */
    match /restaurants/{restaurantId}/visits/{visitId} {
      allow read: if readsFloorPlan(restaurantId);

      allow write: if false;
    }

    // ------------------------------------------------------- table qr tokens

    /**
     * What a scanned table QR code resolves to (GitHub issue #1086).
     *
     * ```text
     * /tableTokens/{token}
     * ```
     *
     * **The one collection an unauthenticated client may read**, and it has to
     * be: a guest scanning a code at a table has no session, and the scan is
     * what establishes which restaurant they would be signing in to. Top-level
     * and named by the token, so the resolution is one document read rather
     * than a query the guest has no rights to run.
     *
     * **`get` and not `list`.** That distinction is the whole enumeration
     * defence. A token can be read by whoever physically holds the code; the
     * set of tokens cannot be walked, so a restaurant's table count, its room
     * layout and its live codes stay unavailable to anyone who was not given
     * one. The token itself carries 130 bits, so guessing one is not the other
     * half of the same attack.
     *
     * **Never client-writable, by anyone, including the restaurant that owns
     * the table.** A token is created by the backend or not at all: an owner
     * able to write here could mint a code pointing at another restaurant's
     * table, or resurrect one that was revoked. Rotation and revocation go
     * through the callables and the trigger, which is also what keeps the token
     * document and `RestaurantTable.qrTokenId` two halves of one write.
     */
    match /tableTokens/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ------------------------------------------------------------------ bites

    match /bites/{biteId} {
      allow read: if signedIn();

      allow create: if owns(request.resource.data, 'userId');

      /**
       * The operator clause is the admin app's Bite migrations — geohash,
       * address backfill, the image migration — which rewrite Bites belonging
       * to every account.
       *
       * The like counters (`thumbup`, `drooling`, `mindblown`) are written by
       * Functions and are deliberately **not** protected here. The edit-Bite
       * path sends the whole Bite back, counters included, so naming them would
       * fail an ordinary edit whenever a like landed between the read and the
       * save. They are cosmetic, they feed no entitlement, and the Bite's own
       * owner is the only account that can touch them.
       */
      allow update: if isOperator() || owns(resource.data, 'userId');

      allow delete: if isOperator() || owns(resource.data, 'userId');

      /** One reaction document per account, named by the account's own uid. */
      match /likes/{likeUserId} {
        allow read: if signedIn();
        allow create, update: if isSelf(likeUserId)
          && owns(request.resource.data, 'userId');
        allow delete: if isSelf(likeUserId);
      }
    }

    // ---------------------------------------------------------------- reviews

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if owns(request.resource.data, 'authorId');
      allow update, delete: if isOperator() || owns(resource.data, 'authorId');
    }

    // ----------------------------------------------------------- bucket lists

    match /bucketlists/{bucketlistId} {
      allow read: if signedIn();
      allow create: if owns(request.resource.data, 'userId');
      allow update, delete: if isOperator() || owns(resource.data, 'userId');
    }

    // ------------------------------------------------------------ bite trails

    match /biteTrails/{biteTrailId} {
      allow read: if signedIn();
      allow create: if owns(request.resource.data, 'ownerId');
      allow update, delete: if isOperator() || owns(resource.data, 'ownerId');

      /**
       * A purchase record, written by the buyer and never rewritten. `soldCount`
       * is derived from how many of these exist rather than stored, so an
       * update path would have nothing to update.
       */
      match /sells/{sellId} {
        allow read: if signedIn();
        allow create: if owns(request.resource.data, 'userId');
        allow update: if false;
        allow delete: if isOperator();
      }

      /** One rating per account, named by the account's own uid. */
      match /ratings/{ratingUserId} {
        allow read: if signedIn();
        allow write: if isSelf(ratingUserId);
      }
    }

    // ------------------------------------------------------------------ users

    /**
     * Fields on the user document that the backend owns.
     *
     * Every one of them is written by a Function through the Admin SDK, and
     * every one of them is read as a fact about the account rather than as
     * something the account said about itself: an entitlement
     * (`subscriptionTier`), a leaderboard input (`biteCount`), a social count,
     * the display-name reservation, or the email-verification state that gates
     * parts of the app. `subscriptionTier` is the sharpest of them — under the
     * blanket rule an account could grant itself Pro with one write.
     *
     * The comparison is by value, so a client that reads a profile and writes
     * the same numbers back is unaffected; only a changed value is refused.
     */
    function backendOwnedUserFields() {
      return [
        'biteCount',
        'followersCount',
        'followingCount',
        'subscriptionTier',
        'normalizedDisplayName',
        'countryCodes',
        'lastSeen',
        'lastSeenTimestamp',
        'appVersion',
        'appBuildNumber',
        'emailVerified',
        'emailVerificationRequired',
        'emailVerificationProvider',
        'emailVerificationReminderCount',
        'emailVerificationLastSentAt',
        'emailVerificationLastSentAtTimestamp',
        'emailVerificationManualLastSentAt',
        'emailVerificationManualLastSentAtTimestamp'
      ];
    }

    match /users/{userId} {
      allow read: if signedIn();

      /**
       * The document is created by `createUserOnAuthCreate` before the account
       * exists to write anything. The create clause is here for the account's
       * own first write in the case where that trigger has not landed yet, and
       * it may not seed the backend-owned fields.
       */
      allow create: if isSelf(userId) && absentAll(backendOwnedUserFields());

      allow update: if isSelf(userId) && unchangedAll(backendOwnedUserFields());

      /** Account deletion runs in `deleteOwnAccount` with the Admin SDK. */
      allow delete: if false;

      /**
       * The follow relationship is written on both accounts: the follower's
       * `following` and the followed account's `followers`. The second is a
       * write to a document under somebody else's user document, which is why
       * the document is named by the follower's uid — that name is the whole
       * authorisation.
       */
      match /followers/{followerId} {
        allow read: if signedIn();
        allow write: if isSelf(followerId);
      }

      match /following/{followedId} {
        allow read: if signedIn();
        allow write: if isSelf(userId);
      }

      /** One document per registered installation of this account. */
      match /pushTokens/{token} {
        allow read, write: if isSelf(userId);
      }
    }

    // --------------------------------------------------------------- settings

    match /settings/{userId} {
      allow read, write: if isSelf(userId);
    }

    // ------------------------------------------------- push token index

    /**
     * Maps an FCM token to the account that registered it, so a rotated or
     * reassigned token can be found without walking every account.
     *
     * **Not readable**, unlike everything else here: it is the one collection
     * whose rows are cross-account identifiers, and no client has ever read it.
     * Writes are allowed only for a row naming the writer.
     */
    match /pushTokens/{token} {
      allow read: if isOperator();
      allow create, update: if owns(request.resource.data, 'userUid');
      allow delete: if isOperator() || owns(resource.data, 'userUid');
    }

    // ----------------------------------------------- backend-owned collections

    /**
     * Read by the apps, written only by Functions through the Admin SDK.
     *
     * `meta` holds the leaderboard snapshots and the exchange-rate table;
     * `displayNames` is the reservation index behind `claimDisplayName`;
     * `restaurantCandidates` is produced by the clustering trigger and consumed
     * by the admin app's verification surface, which acts through
     * `verifyRestaurantCandidate` rather than by writing the candidate.
     */
    match /meta/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /displayNames/{normalizedDisplayName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /restaurantCandidates/{candidateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /**
     * The record of a deleted account, kept for the retention window.
     *
     * Neither readable nor writable by a client. It was readable under the
     * blanket rule and nothing read it; leaving it readable would publish, to
     * every signed-in account, that a given account asked to be deleted.
     */
    match /accountDeletions/{deletionId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------- rest

    /**
     * Anything not named above.
     *
     * A collection this file does not know about is a collection whose
     * ownership nobody has decided, so it is denied rather than left open.
     * Adding a collection to the product means adding it here, and the rules
     * test suite is where that is noticed.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
