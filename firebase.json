{
  "hosting": [
    {
      "target": "cv",
      "public": "dist/apps/cv/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "bite-tribe",
      "public": "dist/apps/bite-tribe",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        },
        {
          "source": "/apple-app-site-association",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
      ],
      "i18n": {
        "root": "/"
      },
      "rewrites": [
        { "source": "/s/**", "function": "handleSharedLinkToBite" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "bite-tribe-business",
      "public": "dist/apps/bite-tribe-business",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "bite-tribe-admin",
      "public": "dist/apps/bite-tribe-admin",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "bite-tribe-storybook",
      "public": "dist/storybook/storybook-host",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
