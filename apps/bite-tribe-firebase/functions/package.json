{
  "name": "functions",
  "scripts": {
    "lint": "eslint",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:emulator:jest": "jest --config jest.emulator.config.cjs --runInBand",
    "test:emulator": "firebase --config ../firebase.emulator-test.json emulators:exec --project bite-tribe-emulator-tests --only firestore \"npm run test:emulator:jest\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "geofire-common": "6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.5.0",
    "graphql": "^16.13.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
