{
  "name": "password-validator",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/common/ui/password-validator/src",
  "prefix": "travellers-apps",
  "tags": ["scope:common", "type:ui", "framework:ionic"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/common/ui/password-validator"],
      "options": {
        "jestConfig": "libs/common/ui/password-validator/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/common/ui/password-validator/**/*.css",
          "libs/common/ui/password-validator/**/*.scss"
        ],
        "formatter": "compact"
      }
    }
  }
}
