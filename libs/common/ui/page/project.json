{
  "name": "common-ui-page",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/common/ui/page/src",
  "prefix": "travellers-apps",
  "tags": ["type:ui", "scope:common", "framework:ionic"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/common/ui/page"],
      "options": {
        "jestConfig": "libs/common/ui/page/jest.config.ts",
        "tsConfig": "libs/common/ui/page/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/common/ui/page/**/*.css",
          "libs/common/ui/page/**/*.scss"
        ],
        "formatter": "compact"
      }
    }
  }
}
