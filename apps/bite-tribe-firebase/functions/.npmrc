# firebase-functions-test (dev-only) still peers firebase-admin <=13, one
# major behind the runtime's firebase-admin 14. The published runtime API is
# compatible, so accept the lagging optional peer here the same way the
# workspace root .npmrc does. Production function deploys omit devDependencies
# and never install firebase-functions-test, so this only affects local/CI
# test installs. Retire once firebase-functions-test peers firebase-admin 14.
legacy-peer-deps=true
