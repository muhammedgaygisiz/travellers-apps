{
  "name": "bite-tribe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/bite-tribe/src",
  "tags": ["scope:bite-tribe", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "plugins": ["apps/bite-tribe/env-var-plugin.js"],
        "outputPath": "dist/apps/bite-tribe",
        "index": "apps/bite-tribe/src/index.html",
        "main": "apps/bite-tribe/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/bite-tribe/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/bite-tribe/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "apps/bite-tribe/public"
          }
        ],
        "styles": [
          "apps/bite-tribe/src/theme/variables.scss",
          "apps/bite-tribe/src/global.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/bite-tribe-common/styles"]
        },
        "scripts": [],
        "serviceWorker": true,
        "ngswConfigPath": "apps/bite-tribe/ngsw-config.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1.8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "bite-tribe:build:production"
        },
        "development": {
          "buildTarget": "bite-tribe:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "bite-tribe:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bite-tribe/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "bite-tribe:build",
        "port": 4200,
        "staticFilePath": "dist/apps/bite-tribe",
        "spa": true
      }
    }
  }
}
