{
  "name": "bite-tribe-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/bite-tribe-admin/src",
  "tags": ["scope:bite-tribe-admin", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "plugins": ["apps/bite-tribe-admin/env-var-plugin.js"],
        "outputPath": "dist/apps/bite-tribe-admin",
        "index": "apps/bite-tribe-admin/src/index.html",
        "main": "apps/bite-tribe-admin/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/bite-tribe-admin/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/bite-tribe-admin/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "libs/bite-tribe-common/assets"
          }
        ],
        "styles": [
          "apps/bite-tribe-admin/src/theme/variables.scss",
          "apps/bite-tribe-admin/src/global.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/bite-tribe-common/styles"]
        },
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2.8mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4500
      },
      "configurations": {
        "production": {
          "buildTarget": "bite-tribe-admin:build:production"
        },
        "development": {
          "buildTarget": "bite-tribe-admin:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "bite-tribe-admin:build",
        "port": 4501,
        "staticFilePath": "dist/apps/bite-tribe-admin/browser",
        "spa": true
      }
    }
  }
}
