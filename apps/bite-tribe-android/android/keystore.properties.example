# Release signing for the BiteTribe Android wrapper.
#
# Copy this file to keystore.properties in the same directory and fill in the
# real values. keystore.properties is gitignored and must never be committed.
#
#   cp apps/bite-tribe-android/android/keystore.properties.example \
#      apps/bite-tribe-android/android/keystore.properties
#
# storeFile may be absolute, or relative to apps/bite-tribe-android/android.
# The passwords are the ones Android Studio has been remembering in the
# "Generate Signed App Bundle" wizard.
#
# CI can supply the same four values as environment variables instead:
#   BITETRIBE_KEYSTORE_FILE
#   BITETRIBE_KEYSTORE_PASSWORD
#   BITETRIBE_KEY_ALIAS
#   BITETRIBE_KEY_PASSWORD

storeFile=/absolute/path/to/bitetribe.jks
storePassword=
keyAlias=
keyPassword=
