{
  "name": "bite-tribe-firebase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/bite-tribe-firebase",
  "targets": {
    "firebase-serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["firebase-build"],
      "options": {
        "cwd": "apps/bite-tribe-firebase",
        "command": "firebase emulators:start --only auth,firestore,storage,functions,pubsub --import .firebase-export"
      }
    },
    "firebase-record": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase",
        "command": "firebase emulators:start --only auth,firestore,storage --import .firebase-export --export-on-exit .firebase-export"
      }
    },
    "firebase-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase/functions",
        "command": "npm run build"
      }
    },
    "firebase-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase/functions",
        "command": "npm run deploy"
      }
    },
    "firebase-deploy-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase/functions",
        "command": "npm run deploy:indexes"
      }
    },
    "firebase-set-geocoding-secret": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase",
        "command": "node scripts/set-geocoding-secret.mjs"
      }
    },
    "firebase-kill": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bite-tribe-firebase",
        "command": "npx kill-port 9099 8080 9000 9199 5001 8085"
      }
    }
  }
}
