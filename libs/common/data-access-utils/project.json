{
  "name": "data-access-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/data-access-utils/src",
  "projectType": "library",
  "tags": ["scope:common"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/common/data-access-utils",
        "main": "libs/common/data-access-utils/src/index.ts",
        "tsConfig": "libs/common/data-access-utils/tsconfig.lib.json",
        "assets": ["libs/common/data-access-utils/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/common/data-access-utils/jest.config.ts"
      }
    }
  }
}
