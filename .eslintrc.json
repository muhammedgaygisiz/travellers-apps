{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "type:finances:app",
                "onlyDependOnLibsWithTags": [
                  "type:finances:shell",
                  "common:utils"
                ]
              },
              {
                "sourceTag": "type:finances:shell",
                "onlyDependOnLibsWithTags": [
                  "type:finances:feature",
                  "type:finances:common:utils",
                  "common:utils",
                  "type:finances:store"
                ]
              },
              {
                "sourceTag": "type:finances:feature",
                "onlyDependOnLibsWithTags": [
                  "type:finances:data-access",
                  "type:finances:common:utils",
                  "type:finances:ui",
                  "common:utils"
                ]
              },
              {
                "sourceTag": "type:finances:data-access",
                "onlyDependOnLibsWithTags": [
                  "type:finances:store",
                  "type:finances:backend-api"
                ]
              },
              {
                "sourceTag": "type:finances:store",
                "onlyDependOnLibsWithTags": [
                  "common:utils",
                  "type:finances:backend-api"
                ]
              },
              {
                "sourceTag": "type:finances:ui",
                "onlyDependOnLibsWithTags": ["common:utils"]
              },
              {
                "sourceTag": "common:utils",
                "onlyDependOnLibsWithTags": ["common:utils"]
              },
              {
                "sourceTag": "type:kosaml:app",
                "onlyDependOnLibsWithTags": [
                  "type:kosaml:shell",
                  "type:kosaml:feature",
                  "type:kosaml:store",
                  "type:kosaml:common:feature"
                ]
              },
              {
                "sourceTag": "type:kosaml:shell",
                "onlyDependOnLibsWithTags": [
                  "type:kosaml:feature",
                  "type:kosaml:common:feature"
                ]
              },
              {
                "sourceTag": "type:kosaml:feature",
                "onlyDependOnLibsWithTags": [
                  "type:kosaml:model",
                  "type:kosaml:common:feature",
                  "type:kosaml:store"
                ]
              },
              {
                "sourceTag": "type:kosaml:common:feature",
                "onlyDependOnLibsWithTags": [
                  "type:kosaml:common:feature",
                  "type:kosaml:model"
                ]
              },
              {
                "sourceTag": "type:kosaml:store",
                "onlyDependOnLibsWithTags": [
                  "type:kosaml:model",
                  "common:utils"
                ]
              },
              {
                "sourceTag": "type:prices:app",
                "onlyDependOnLibsWithTags": [
                  "type:prices:shell",
                  "common:utils",
                  "type:prices:store"
                ]
              },
              {
                "sourceTag": "type:prices:shell",
                "onlyDependOnLibsWithTags": ["type:prices:feature"]
              },
              {
                "sourceTag": "type:prices:feature",
                "onlyDependOnLibsWithTags": [
                  "type:prices:store",
                  "common:utils",
                  "type:prices:ui"
                ]
              },
              {
                "sourceTag": "type:prices:store",
                "onlyDependOnLibsWithTags": [
                  "common:utils",
                  "type:prices:backend-api"
                ]
              },
              {
                "sourceTag": "type:prices:ui",
                "onlyDependOnLibsWithTags": ["common:utils"]
              }
            ]
          }
        ],
        "@typescript-eslint/explicit-function-return-type": "error"
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {
        "no-unused-vars": "error",
        "@typescript-eslint/no-extra-semi": "error",
        "no-extra-semi": "off"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {
        "@typescript-eslint/no-extra-semi": "error",
        "no-extra-semi": "off"
      }
    },
    {
      "files": ["*.stories.*", "main.js"],
      "extends": ["plugin:storybook/recommended"]
    }
  ]
}
