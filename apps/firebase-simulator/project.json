{
  "name": "firebase-simulator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/firebase-simulator/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firebase-simulator",
        "command": "firebase emulators:start --only auth,firestore,storage --import .firebase-export"
      }
    },
    "firebase-record": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/firebase-simulator",
        "command": "firebase emulators:start --only auth,firestore,storage --import .firebase-export --export-on-exit .firebase-export"
      }
    }
  }
}
