<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

  <application
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/AppTheme">
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
      android:exported="true"
      android:label="@string/title_activity_main"
      android:launchMode="singleTask"
      android:theme="@style/AppTheme.NoActionBarLaunch">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!--
        Verified App Links, one filter per host (GitHub issue #345).

        Three hosts serve the same build and each serves its own
        `.well-known/assetlinks.json`: `bitetribe.app` is the canonical one
        decided in issue #1454 and the one printed into every table QR code,
        `www.bitetribe.app` is the address a guest reaches by typing, and
        `bite-tribe.web.app` is where every share link sent before this change
        still points. None of the three can be dropped - a link already sitting
        in a WhatsApp thread has to keep opening the app.

        One filter per host rather than one filter listing all three, because
        `autoVerify` is evaluated per filter: split like this, a host that fails
        verification cannot take the other two down with it.

        Every path on every host, because all three serve the same app and a
        link that arrived on the wrong host should still open here rather than
        fall to the browser for a reason no guest can see.

        `/s/bite` keeps its prefix exactly as it verified on 30 August 2026
        (see ssot/current-state/release-state.md); `/t/` and `/m/` carry their
        trailing slash so each matches the scanned address and nothing else
        that may later start with the same letter.

        `/m/` is the published menu of issue #370 - a code a restaurant prints
        for its window rather than for a table. A guest with the app installed
        lands on the in-app menu, and a stranger on the public page in the
        browser; both read the same menu, which is the whole point of giving
        the path to the app rather than leaving it to the browser.
      -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:host="bitetribe.app"
          android:pathPrefix="/s/bite"
          android:scheme="https" />
        <data
          android:host="bitetribe.app"
          android:pathPrefix="/t/"
          android:scheme="https" />
        <data
          android:host="bitetribe.app"
          android:pathPrefix="/m/"
          android:scheme="https" />
      </intent-filter>

      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:host="www.bitetribe.app"
          android:pathPrefix="/s/bite"
          android:scheme="https" />
        <data
          android:host="www.bitetribe.app"
          android:pathPrefix="/t/"
          android:scheme="https" />
        <data
          android:host="www.bitetribe.app"
          android:pathPrefix="/m/"
          android:scheme="https" />
      </intent-filter>

      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
          android:host="bite-tribe.web.app"
          android:pathPrefix="/s/bite"
          android:scheme="https" />
        <data
          android:host="bite-tribe.web.app"
          android:pathPrefix="/t/"
          android:scheme="https" />
        <data
          android:host="bite-tribe.web.app"
          android:pathPrefix="/m/"
          android:scheme="https" />
      </intent-filter>
    </activity>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
  </application>

  <!-- Permissions -->

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Needed if you want to retrieve unredacted EXIF metadata from photos -->
  <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
  <!-- Needed if you want to read files from external storage -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
</manifest>
