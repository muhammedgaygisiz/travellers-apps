{
  "name": "bite-tribe-android",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bite-tribe-android",
  "prefix": "bite-tribe-android",
  "tags": ["scope:bite-tribe"],
  "implicitDependencies": ["bite-tribe"],
  "targets": {
    "build": {
      "options": {
        "outputPath": "dist/apps/bite-tribe"
      }
    },
    "cap": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "--help"
      }
    },
    "copy": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "copy android"
      }
    },
    "open": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "open android"
      }
    },
    "run": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "run android"
      },
      "configurations": {
        "android": {
          "cmd": "run android"
        }
      }
    },
    "sync": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "sync android"
      }
    },
    "update": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "update android"
      }
    },
    "doctor": {
      "executor": "@nxext/capacitor:cap",
      "options": {
        "cmd": "doctor android"
      }
    }
  }
}
